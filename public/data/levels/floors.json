  "version": 1,
  "milestone": "M1",
  "layout": {
    "coordinates": "x is game px inside the 720-wide floor; sizes come from balance.world (stairwell 0-120, left apartment 120-420, right apartment 420-720). Floor height is 240; layer sets the vertical band.",
    "layers": {
      "floor": "furniture standing on the floor (lower band)",
      "wall": "wall-mounted or counter-height things (upper band): cupboards, drawers, microwaves, windows, curtains, lamps, cabinets",
      "door": "interior doors on a room boundary (x 270 left apartment, x 570 right apartment). Interior doors never block walking; they are only salvage. No object on any layer is within 48 px of an interior door's x."
    },
    "slots": {
      "left": [168, 270, 372],
      "right": [468, 570, 672],
      "rule": "Objects in the same layer are >= 96 px apart (controls.minHitAreaPx), including across the wall between apartments (372 to 468). At most one object per slot per layer."
    },
    "stairwell": { "xMin": 0, "xMax": 120, "entryX": 60 },
    "doorX": { "left": 130, "right": 430 },
    "rooms": "A room is an x range inside an apartment; an object belongs to the room containing its x (boundary x goes to the first room). Unentered rooms are dark.",
    "doorStates": "open | jammed (3 hits or crowbar 1 s). 'locked' is reserved, unused in M1.",
    "zombieRule": "Left-apartment zombies stand at x >= 240, right-apartment zombies at x >= 500, so nothing waits on the stairwell entry. Every zombie has facing 'left' or 'right' (GDD 5.4). Sight uses balance zombies.sight: in front 180 px Grey/Lit, 110 Dim, 70 Dark; behind 24 px walking, 60 px running; entering a room never wakes a zombie. Placement: at most 1 walker in the first room of a unit, walker pairs face away and sit >= 150 px from the entrance, never 3 walkers in a room.",
    "fixedLoot": "fixedLoot is a guaranteed list of {id, qty} given on first Search. If fixedLoot is present the object makes 0 table rolls unless 'rolls' [min,max] is given, then those rolls are added from its lootTable. Without fixedLoot the container uses balance.scavenge.lootRolls.",
    "foundNote": "Optional {id, text}: shown the first time the object is searched."
  },
